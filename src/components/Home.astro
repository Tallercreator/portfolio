---
import Base from '../layouts/Base.astro';
import CaseCard from './CaseCard.astro';
import Gallery from './Gallery.astro';
import { getCases } from '../lib/cases';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cases = await getCases(lang);

const intro =
  lang === 'ru'
    ? 'Продуктовый дизайнер, в профессии четыре с половиной года. Последние два — во внутренних продуктах ОТП Банка: HR-платформа, которой пользуются 7000 сотрудников. Веду модули от гипотезы до прода, включая логику, тексты и передачу в разработку. Код и ИИ использую как рабочие инструменты.'
    : 'Product designer, four and a half years in. The last two on internal products at OTP Bank — an HR platform used by 7,000 people. I run modules from hypothesis to production, including the logic, the copy and the handoff to engineering. Code and AI are part of how I work.';
---

<Base bare>
  <section class="page hero">
    <h1>
      <span class="lead">{t('home.heroLead')}</span>{' '}
      <span class="rest">{t('home.heroRest')}</span>
    </h1>
  </section>

  <section class="page work" id="work" aria-labelledby="work-heading">
    <h2 id="work-heading" class="section-heading">{t('home.workHeading')}</h2>
    <div class="grid">
      {cases.map((item) => <CaseCard entry={item.entry} lang={lang} slug={item.slug} />)}
    </div>
  </section>

  <section class="page about" aria-labelledby="about-heading">
    <h2 id="about-heading" class="section-heading">{t('home.aboutHeading')}</h2>
    <p class="intro">{intro}</p>
    <p class="more">
      <a href={localizePath('/about', lang)}>{t('home.aboutMore')} →</a>
    </p>
  </section>

  <Gallery heading={t('home.galleryHeading')} />
</Base>

<style>
  .hero {
    padding-block: clamp(var(--s-8), 12vh, var(--s-10)) var(--s-9);
  }

  .hero h1 {
    /* 30ch держит строку в четыре строки на десктопе: при 18ch их становится шесть. */
    max-width: 30ch;
    font-size: clamp(var(--t-xl), 5vw, var(--t-4xl));
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    font-weight: var(--fw-semibold);
    text-wrap: pretty;
  }

  /* Роль читается первой, описание уходит на второй план — но остаётся в одном блоке. */
  .hero .lead {
    color: var(--color-text);
  }

  .hero .rest {
    color: var(--color-text-muted);
  }

  .section-heading {
    margin-block-end: var(--s-6);
    font-size: var(--t-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .work {
    padding-block-end: var(--s-9);
  }

  .grid {
    display: grid;
    gap: var(--s-8) var(--s-6);
  }

  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Первый кейс — дизайн-система — занимает всю ширину:
       он задаёт рамку чтения всего остального. */
    .grid > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }

  .about {
    padding-block: var(--s-8);
    border-block-start: 1px solid var(--color-border);
  }

  .intro {
    max-width: var(--measure);
  }

  .more {
    margin-block-start: var(--s-4);
    font-size: var(--t-sm);
  }
</style>
