---
import { existsSync } from 'node:fs';
import LangSwitch from './LangSwitch.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

/* Ссылку на резюме показываем только когда файл действительно лежит в public. */
const hasCv = existsSync(new URL('../../public/cv.pdf', import.meta.url));

interface Props {
  bare?: boolean;
}

const { bare = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = localizePath('/', lang);
const about = localizePath('/about', lang);

const isCurrent = (path: string) =>
  Astro.url.pathname === path || Astro.url.pathname === `${path}/`;
---

<header class="site-header">
  <div class="page inner">
    <a class="wordmark" href={home} aria-current={isCurrent(home) ? 'page' : undefined}>
      {bare ? <span class="visually-hidden">{t('site.title')}</span> : t('site.title')}
    </a>

    <nav aria-label={lang === 'ru' ? 'Основная навигация' : 'Primary'}>
      <ul>
        <li>
          <a href={`${home}#work`}>{t('nav.work')}</a>
        </li>
        <li>
          <a href={about} aria-current={isCurrent(about) ? 'page' : undefined}>
            {t('nav.about')}
          </a>
        </li>
        {
          hasCv && (
            <li>
              <a href="/cv.pdf" download>
                {t('nav.cv')}
              </a>
            </li>
          )
        }
        <li><LangSwitch /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.5rem;
  }

  .wordmark {
    font-size: var(--t-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-sm);
  }

  nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    padding-block: var(--s-2);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  @media (max-width: 30rem) {
    .wordmark {
      max-width: 9rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    nav ul {
      gap: var(--s-3);
    }
  }
</style>
