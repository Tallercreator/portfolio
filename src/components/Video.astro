---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Путь от корня public, например '/video/travel/statuses.mp4' */
  src: string;
  /** WebM той же записи, если есть. Браузер возьмёт его первым — он легче. */
  webm?: string;
  /** Первый кадр. Показывается до загрузки и вместо видео при prefers-reduced-motion. */
  poster?: ImageMetadata;
  posterAlt?: string;
  /** Подпись обязательна по смыслу: она говорит, что происходит на записи. */
  caption?: string;
  /**
   * loop — короткий немой цикл 5–15 секунд, играет сам
   * controls — длинная запись, человек запускает сам
   */
  mode?: 'loop' | 'controls';
  width?: 'text' | 'wide' | 'full';
  frame?: boolean;
}

const {
  src,
  webm,
  poster,
  posterAlt,
  caption,
  mode = 'loop',
  width = 'wide',
  frame = true,
} = Astro.props;

const isLoop = mode === 'loop';

/* В MDX путь пишется от корня public; базу подставляем здесь, чтобы не помнить о ней. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path.startsWith('/') ? path : `/${path}`}`;
---

<figure class:list={['video-figure', `w-${width}`]}>
  <div class:list={['media', { frame }]} data-video-mode={mode}>
    {
      poster && (
        /* Постер лежит отдельной картинкой: он же fallback, когда движение выключено. */
        <div class="poster" hidden>
          <Image
            src={poster}
            alt={posterAlt ?? ''}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 76rem) 72rem, 100vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }

    <video
      preload="none"
      playsinline
      muted={isLoop}
      loop={isLoop}
      controls={!isLoop}
      poster={poster?.src}
      aria-label={caption}
    >
      {webm && <source src={withBase(webm)} type="video/webm" />}
      <source src={withBase(src)} type="video/mp4" />
    </video>
  </div>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  /*
    Автоплей включаем только скриптом и только когда:
    1) человек не просил уменьшить движение;
    2) запись реально попала в кадр — иначе не грузим её вообще.
    Без скрипта видео просто останется постером с кнопкой воспроизведения.
  */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const setup = (wrapper: HTMLElement) => {
    const video = wrapper.querySelector('video');
    const poster = wrapper.querySelector<HTMLElement>('.poster');
    if (!video) return;

    if (wrapper.dataset.videoMode !== 'loop') return;

    const stopAndShowPoster = () => {
      video.pause();
      video.removeAttribute('autoplay');
      if (poster) {
        poster.hidden = false;
        video.hidden = true;
      } else {
        video.controls = true;
      }
    };

    if (reduceMotion.matches) {
      stopAndShowPoster();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            video.preload = 'auto';
            void video.play().catch(() => {
              /* автоплей заблокирован политикой браузера — оставляем управление человеку */
              video.controls = true;
            });
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px', threshold: 0.25 }
    );

    observer.observe(video);
    reduceMotion.addEventListener('change', (event) => {
      if (event.matches) {
        observer.disconnect();
        stopAndShowPoster();
      }
    });
  };

  document.querySelectorAll<HTMLElement>('[data-video-mode]').forEach(setup);
</script>

<style>
  .video-figure {
    margin-block: var(--s-7);
  }

  .media.frame {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-subtle);
  }

  video {
    display: block;
    width: 100%;
    height: auto;
  }

  .poster :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-block-start: var(--s-3);
    max-width: var(--measure);
    font-size: var(--t-sm);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
  }

  .w-text {
    max-width: var(--measure);
  }

  .w-wide,
  .w-full {
    width: 100%;
  }

  @media (min-width: 64rem) {
    .w-wide {
      width: min(100%, 56rem);
    }
  }
</style>
